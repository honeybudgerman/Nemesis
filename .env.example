# --- Supabase (Project Settings → API) ---
# Public values: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit a real value.
# Used by Route Handlers to call the game's transactional SQL functions.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter (Sprint 3, AI mentor) --- SERVER ONLY
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Tests (optional) ---
# Admin connection to a local PostgreSQL for integration tests, e.g.
# postgres://postgres@localhost:54329/postgres
TEST_DATABASE_URL=
